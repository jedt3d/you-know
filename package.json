{
  "name": "you-know",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "node --test tests/scoring.test.ts tests/text.test.ts tests/validate.test.ts",
    "e2e": "node tests/e2e-ws.mjs",
    "db:migrate:local": "wrangler d1 migrations apply you-know --local",
    "db:migrate": "wrangler d1 migrations apply you-know --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "hono": "^4.6.14",
    "preact": "^10.25.1",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
