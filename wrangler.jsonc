{
  // You Know? — one Worker serves the SPA (static assets), the REST API,
  // D1 (quiz storage) and one hibernating Durable Object per live session.
  "name": "you-know",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Hash routes are used client-side, but keep SPA fallback so /join/CODE
    // style paths also work if we move to path routing later.
    "not_found_handling": "single-page-application",
    // API + WS must reach the Worker before asset matching (SPA fallback
    // would otherwise swallow them).
    "run_worker_first": ["/api/*", "/ws/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "you-know",
      // Placeholder for local dev; replace with the real id after
      // `wrangler d1 create you-know` (see README deploy steps).
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "SessionDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],

  "observability": { "enabled": true }
}
